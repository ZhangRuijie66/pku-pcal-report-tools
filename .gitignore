# 只跟踪各工具目录与公共核心/测试（数据、报告输出、发布包、学习资料都不进仓库）
/*
!/.gitignore
!/README.md
!/LICENSE
!/requirements.txt
!/启动入口.cmd
!/启动入口.vbs
!/停止服务.vbs
!/安装依赖.cmd
!/make_portable.py
!/make_release.py
!/更新日志/
!/_tools/
!/_core/
!/tests/
!/物化实验报告工具/
!/燃烧热工具/
!/溶解热工具/
!/紫外光谱工具/
!/表面吸附工具/
!/化学动力学工具/
!/电化学工具/
!/电导率工具/
!/蒸气压工具/
!/偶极矩工具/
!/双液系工具/
!/磁化率工具/

# 个人档案（入口页生成，含姓名/学号，不进仓库）
/profile.json

# 通用排除（对所有层级生效）
__pycache__/
*.py[cod]
settings.json
_test_out/
*.bak
_tools/启动日志.log
.dsh-ops-update-*.lock
/_core/backups/

# 更新链路的本机状态（检查结果缓存 + 旧版备份，不进仓库；也说明见 README「版本号与自动更新」）
/update_state.json
/_core/updates/

# 两个手工录入模块的本地数据（示例/个人数据，不进仓库）
/表面吸附工具/data/
/化学动力学工具/data/
/蒸气压工具/data/
/偶极矩工具/data/
/双液系工具/data/
/磁化率工具/data/

# 启动器的依赖探测缓存：按本机 Python 路径与依赖清单生成，换机器就该重探，
# 提交进仓库只会让别人的机器用上作者机器的结论。
/_tools/deps_cache.json
