# 只跟踪四个工具目录（数据、报告输出、发布包、学习资料都不进仓库）
/*
!/.gitignore
!/README.md
!/LICENSE
!/requirements.txt
!/启动入口.cmd
!/启动入口.vbs
!/停止服务.vbs
!/安装依赖.cmd
!/_tools/
!/物化实验报告工具/
!/燃烧热工具/
!/溶解热工具/
!/紫外光谱工具/
!/表面吸附工具/
!/化学动力学工具/
!/电化学工具/
!/电导率工具/
!/蒸气压工具/
!/偶极矩工具/
!/双液系工具/

# 通用排除（对所有层级生效）
__pycache__/
*.py[cod]
settings.json
_test_out/
*.bak
_tools/启动日志.log
.dsh-ops-update-*.lock

# 两个手工录入模块的本地数据（示例/个人数据，不进仓库）
/表面吸附工具/data/
/化学动力学工具/data/
/蒸气压工具/data/
/偶极矩工具/data/
/双液系工具/data/
